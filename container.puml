@startuml container
skinparam ActivityBackgroundColor #E8F5E9
skinparam ActivityBorderColor #2E7D32
skinparam ActivityFontName Arial
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #FBC02D

title Fluxograma de Processo - Cálculo de Lucro Real e Perdas (Hortaliças)

start

:Entrada de Dados pelo Produtor;
note right
  **Dados informados:**
  * Qc = Quantidade Colhida (unidades)
  * Qv = Quantidade Vendida (unidades)
  * Qp = Quantidade Perdida/Descarte (unidades)
  * P  = Preço de Venda Unitário (R$)
end note

partition "Processamento do Sistema" {
    :1. Calcular Estoque Restante;
    note left
      **Fórmula:**
      Estoque = Qc - (Qv + Qp)
    end note

    :2. Calcular Prejuízo das Perdas;
    note left
      **Fórmula:**
      Prejuizo = Qp * P
    end note

    :3. Calcular Lucro Real do Dia;
    note left
      **Fórmula:**
      Lucro = (Qv * P) - Prejuizo
    end note
}

:Exibir Resumo Financeiro e de Estoque;
note right
  **Resultados na Tela:**
  - Saldo Atual de Estoque
  - Valor Perdido (Deterioração)
  - Lucro Real Obtido
end note

stop
@enduml